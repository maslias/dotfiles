#!/bin/bash

echo "Second Brain Automatior..."

extract_hub_args() {
    local line="$1"
    # Extract content between [[ and ]]
    echo "$line" | sed -n 's/.*hubs: *\[\[\([^]]*\)\]\].*/\1/p' | tr ',' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
}

extract_tags() {
  local line="$1"
  echo "$line" | grep -oE '#[^,# ]+' | paste -sd' ' -
}

extract_date() {
  local line="$1"
  echo "$line" | grep -oE '[0-9]{4}-[0-9]{1,2}-[0-9]{1,2}' | sed 's/^/#/'

}

get_basename() {
    local filepath="$1"
    basename "$filepath" .md
}

link_exists_in_file() {
    local file="$1"
    local link="$2"
    
    if [ -f "$file" ]; then
        grep -q "\[\[$link\]\]" "$file" 2>/dev/null
    else
        return 1
    fi
}

add_link_to_hub() {
    local hub_file="$1"
    local source_file="$2"
    local date_arg="$3"
    local tags_arg="$4"
    local source_basename=$(get_basename "$source_file")
    echo "- [[$source_basename]] $date_arg $tags_arg" >> "$hub_file"
}

while IFS= read -r -d '' file; do
    while IFS= read -r line; do

        # Check if line has date
        if echo "$line" | grep -q "created:*" || echo "$line" | grep -q "date:*"; then
          date_arg=$(extract_date "$line")
        fi

        # Check if line has tags
        if echo "$line" | grep -q "tags:*"; then
          tags_args=$(extract_tags "$line")
        fi

        # Check if line contains hubs pattern
        if echo "$line" | grep -q "hubs: *\[\[.*\]\]"; then
            # Extract hub arguments
            hub_args=$(extract_hub_args "$line")

            # Process each hub argument
            while IFS= read -r arg; do
                if [ -n "$arg" ]; then

                    hub_file="$XDG_SECOND_BRAIN_HOME/hubs/$arg.md"
                    source_basename=$(get_basename "$file")

                    # Check if hub file exists, create if not
                    if [ ! -f "$hub_file" ]; then
                      touch $hub_file
                      created_hubs=$((created_hubs + 1))
                    fi

                    # Check if link already exists in hub file
                    if ! link_exists_in_file "$hub_file" "$source_basename"; then
                        add_link_to_hub "$hub_file" "$file" "$date_arg" "$tags_args"
                        added_links=$((added_links + 1))
                    fi
                fi
            done <<< "$hub_args"
            break
        fi
    done < "$file"
    
done < <(find "$XDG_SECOND_BRAIN_HOME" -name "*.md" -type f -print0)

echo "Process Hubs complete!"
echo "  Hub files created: $created_hubs"
echo "  Links added: $added_links"
