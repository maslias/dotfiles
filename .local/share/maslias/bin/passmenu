#!/bin/bash

# shopt -s nullglob globstar

prefix=${PASSWORD_STORE_DIR-~/.password-store}
password_files=$(find $prefix -type f -name "*.gpg" | sed "s|^${prefix}/||" | sed 's/\.gpg$//')

password=$(printf '%s\n' "$password_files" | walker --dmenu -p 'Choose from password store')

[[ -n $password ]] || exit

pass_cmd=show
if pass show "$password" | grep -q '^otpauth://'; then
	pass_cmd=otp
fi

pass $pass_cmd -c "$password" 2>/dev/null
